# PostgreSQL Configuration
POSTGRES_DB=userdb
POSTGRES_USER=userapp
POSTGRES_PASSWORD=userpass
POSTGRES_PORT=5432

# Application Configuration
APP_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# JVM Options
JAVA_OPTS=-Xms256m -Xmx512m

# Logging
LOGGING_LEVEL=DEBUG

# Jwt
JWT_SECRET=your-secret-key-must-be-at-least-256-bits-long-for-hs256-algorithm-change-in-production
JWT_EXPIRATION=86400000