# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# User Service
USER_DB_NAME=userdb
USER_DB_PORT=5432
USER_SERVICE_PORT=8081

# Product Service
PRODUCT_DB_NAME=productdb
PRODUCT_DB_PORT=5433
PRODUCT_SERVICE_PORT=8082

# Order Service
ORDER_DB_NAME=orderdb
ORDER_DB_PORT=5434
ORDER_DB_USER=orderuser
ORDER_DB_PASSWORD=orderpass
ORDER_SERVICE_PORT=8083


# Notification Service (future)
NOTIFICATION_DB_NAME=notificationdb
NOTIFICATION_DB_PORT=5435
NOTIFICATION_SERVICE_PORT=8084

# API Gateway
API_GATEWAY_PORT=8080
JWT_SECRET=your-secret-key-must-be-at-least-256-bits-long-for-hs256-algorithm-change-in-production
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=*

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Spring Profile
SPRING_PROFILE=docker